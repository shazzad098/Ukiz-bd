# ------------------------------------------------------------------
# UKIX-BD environment. Copy to `.env` and fill in your own values.
# Without DATABASE_URL the app runs on built-in in-memory data.
# ------------------------------------------------------------------

# Supabase Postgres connection string.
# Supabase Dashboard → Project Settings → Database → Connection string.
# Use the pooler URL (port 6543, "Transaction" mode) — it survives
# serverless restarts. It looks like:
# postgresql://postgres.[ref]:[password]@aws-0-ap-south-1.pooler.supabase.com:6543/postgres
DATABASE_URL=

# Admin panel login
ADMIN_LOGIN_ID=arafat5890
# sha256 of the admin password. Generate with:
# node -e "console.log(require('node:crypto').createHash('sha256').update('YOUR_PASSWORD').digest('hex'))"
ADMIN_PASSWORD_SHA256=

# Signs admin + customer session cookies. Set a long random string.
JWT_SECRET=

# Supabase Storage (device image uploads from the admin panel).
# Supabase Dashboard → Project Settings → API: URL + service_role key.
# The service key stays server-side only. Image URLs keep working without these.
SUPABASE_URL=
SUPABASE_SERVICE_KEY=

# Port for `npm run dev` / `npm start`
PORT=3000
