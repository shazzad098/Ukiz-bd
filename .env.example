# UKIX-BD environment. Copy to `.env` and fill in your own values.
# Development can run on built-in in-memory data; production requires Supabase.
# ------------------------------------------------------------------

# Supabase Postgres connection string.
# Supabase Dashboard → Project Settings → Database → Connection string.
# Use the pooler URL (port 6543, "Transaction" mode) — it survives
# serverless restarts. It looks like:
# postgresql://postgres.[ref]:[password]@aws-0-ap-south-1.pooler.supabase.com:6543/postgres
DATABASE_URL=

# Admin panel login. REQUIRED in production — the server refuses to start without it.
ADMIN_LOGIN_ID=
# Admin password hash. Recommended: scrypt `salt:hash` — generate with:
# node -e "const c=require('node:crypto');const s=c.randomBytes(16).toString('hex');console.log(s+':'+c.scryptSync('YOUR_PASSWORD',s,64).toString('hex'))"
ADMIN_PASSWORD_HASH=

# Optional verified online payments. Keep blank to offer COD only.
# For sandbox use the bKash sandbox base URL; use the live URL supplied by bKash for production.
PUBLIC_APP_URL=https://ukizbd.com
BKASH_BASE_URL=https://tokenized.sandbox.bka.sh/v2/tokenized-checkout
BKASH_USERNAME=
BKASH_PASSWORD=
BKASH_APP_KEY=
BKASH_APP_SECRET=
# Legacy alternative (weaker, unsalted sha256 hex) — generate with:
# node -e "console.log(require('node:crypto').createHash('sha256').update('YOUR_PASSWORD').digest('hex'))"
ADMIN_PASSWORD_SHA256=

# Signs admin + customer session cookies. Set a long random string.
# REQUIRED in production — the server refuses to start without it. Generate with:
# node -e "console.log(require('node:crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=

# Optional: extra origins (comma-separated) allowed to send state-changing
# requests to this API. Normally unset — the site serves its own API, so the
# CSRF origin guard already accepts same-origin requests.
# ALLOWED_ORIGINS=

# Supabase Storage (device image uploads from the admin panel).
# Supabase Dashboard → Project Settings → API: URL + service_role key.
# The service key stays server-side only. Image URLs keep working without these.
SUPABASE_URL=
SUPABASE_SERVICE_KEY=

# Port for `npm run dev` / `npm start`
PORT=3000
